{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "eslint/no-unused-vars": "warn",
    "eslint/no-unused-expressions": ["warn", { "allowShortCircuit": true, "allowTernary": true }],
    "eslint/no-underscore-dangle": "off",
    "eslint/no-shadow": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/require-module-specifiers": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-unassigned-import": "warn",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "warn",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": ["dist", "node_modules", "src/lib/preset-templates.json"]
}
